# Databricks Workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# OAuth M2M Credentials (Service Principal)
DATABRICKS_CLIENT_ID=your-client-id-uuid
DATABRICKS_CLIENT_SECRET=your-client-secret

# Lakebase PostgreSQL Connection
DATABRICKS_PG_HOST=instance-xxx.database.cloud.databricks.com
DATABRICKS_PG_PORT=5432
DATABRICKS_PG_DATABASE=databricks_postgres
DATABRICKS_PG_USERNAME=your-email@databricks.com

# Optional: Rotation interval in minutes (default: 50)
ROTATION_INTERVAL_MINUTES=50

# Optional: Health check port (disabled by default)
# HEALTH_CHECK_PORT=9090

# Optional: Audit log path
# AUDIT_LOG_PATH=~/.databricks_audit.log
